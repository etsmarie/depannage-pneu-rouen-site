---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { NAP } from '~/data/nap.ts';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/+$/, '') || '/',
  noindex = false,
  schema,
} = Astro.props;

const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const effectiveNoindex = noindex || isPreview;

const canonical = `${NAP.baseUrl}${canonicalPath}`;

const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {effectiveNoindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${NAP.baseUrl}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${NAP.baseUrl}/og.png`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={NAP.name} />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#2b3540" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <slot name="schema" />
  </head>
  <body>
    <a href="#main" class="sr-only">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
      <script is:inline data-mpm-a>
      (function(){try{var s=location.hostname.replace('www.','').replace('depannage-pneu-','').replace('.fr','');var u='https://files.mariepneumobile.fr/a/';var b=function(e,d){d.s=s;d.p=location.pathname;try{navigator.sendBeacon(u+e,new Blob([JSON.stringify(d)],{type:'application/json'}))}catch(x){}};
      b('v',{r:document.referrer.slice(0,200)});document.addEventListener('click',function(ev){var a=ev.target.closest&&ev.target.closest('a');if(!a)return;var h=a.getAttribute('href')||'';if(h.indexOf('tel:')===0)b('c',{k:'tel'});else if(h.indexOf('wa.me')>-1||h.indexOf('whatsapp')>-1)b('c',{k:'wa'});else if(/contact|rappel/.test(h))b('c',{k:'cta'})},true)}catch(e){}})();
    </script>
  </body>
</html>
