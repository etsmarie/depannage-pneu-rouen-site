---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { NAP } from '~/data/nap.ts';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/',
  noindex = false,
  schema,
} = Astro.props;

const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const effectiveNoindex = noindex || isPreview;

const canonical = `${NAP.baseUrl}${canonicalPath}`;

const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {effectiveNoindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={NAP.name} />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#2b3540" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <slot name="schema" />
  </head>
  <body>
    <a href="#main" class="sr-only">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
