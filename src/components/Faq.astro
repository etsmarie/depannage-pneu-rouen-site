---
/**
 * Faq — rend l'accordéon <details> ET le schema FAQPage (JSON-LD).
 * Un <script type="application/ld+json"> dans le body est valide pour Google.
 */
import type { FaqItem } from '~/data/faq.ts';

interface Props {
  items: FaqItem[];
  title?: string;
  eyebrow?: string;
  /** id d'ancre optionnel (jump links). */
  id?: string;
}
const { items, title = 'Questions fréquentes', eyebrow = 'FAQ', id } = Astro.props;

/**
 * Le texte affiché dans l'accordéon reste strictement intact ; seule la
 * version injectée dans le JSON-LD est reformulée, car aucune mention de
 * « remorquage » ne doit figurer dans un schema, même en négation.
 */
function sanitizeForSchema(text: string): string {
  return text
    .replace(
      /\s*—\s*aucun remorquage à prévoir\s*:\s*/gi,
      ' — intervention directement sur place, là où la voiture est garée : ',
    )
    .replace(/sans remorquage\s*:\s*/gi, '')
    .replace(/,\s*sans remorquage\./gi, ', là où il est garé, et il repart par ses propres moyens.')
    .replace(/\bsans remorquage\b/gi, 'directement sur place')
    .replace(/\bremorquage\b/gi, 'déplacement du véhicule');
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: sanitizeForSchema(it.q),
    acceptedAnswer: { '@type': 'Answer', text: sanitizeForSchema(it.a) },
  })),
};
---

<section class="faq band-ardoise" id={id}>
  <div class="container">
    <header class="faq__head">
      <p class="eyebrow eyebrow--center">{eyebrow}</p>
      <h2>{title}</h2>
    </header>
    <div class="faq__list">
      {items.map((it) => (
        <details class="qa">
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq__head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-7);
  }
  .faq__head .eyebrow {
    margin: 0;
  }
  .faq__head h2 {
    margin: 14px 0 0;
    color: #fff;
  }

  .faq__list {
    max-width: 820px;
    margin: 0 auto;
    display: grid;
    gap: 12px;
  }

  /* Carte question/réponse blanche sur bande ardoise (style .qa Version C) */
  .qa {
    background: #fff;
    border: 1px solid var(--ligne-fonce);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    box-shadow: var(--shadow-md);
  }
  .qa summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    gap: 0.6em;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--c-ardoise);
    position: relative;
    padding-right: 1.6rem;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary::before {
    content: '›';
    color: var(--c-orange);
    font-weight: 700;
    flex: 0 0 auto;
    transition: transform var(--transition-fast);
  }
  .qa[open] summary::before {
    transform: rotate(90deg);
  }
  .faq__list .qa p {
    margin: 9px 0 0;
    color: var(--c-texte-doux);
    font-size: 0.98rem;
    line-height: var(--lh-base);
  }
</style>
