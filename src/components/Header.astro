---
import { NAP } from '~/data/nap.ts';
---

<div class="topbar">
  Pneu crevé sur les quais ou rive gauche ? <b>On vient à vous 24h/24</b> — sur place, sans remorquage
</div>

<header class="site-head">
  <div class="container head-inner">
    <a href="/" class="brand" aria-label={`Accueil — ${NAP.name}`}>
      <span class="brand__mark" aria-hidden="true">L</span>
      <span class="brand__text">
        <span class="brand__title">Lucas Dépannage</span>
        <span class="brand__sub">Pneu · Rouen &amp; Seine-Maritime</span>
      </span>
    </a>

    <nav aria-label="Navigation principale" class="head-nav">
      <a href="/comment-ca-marche">Comment ça marche</a>
      <a href="/services">Services</a>
      <a href="/tarifs">Tarifs</a>
      <a href="/zones-intervention">Zones</a>
    </nav>

    <div class="head-cta">
      <span class="head-phone">{NAP.phoneDisplay}</span>
      <a href={`tel:${NAP.phoneE164}`} class="btn btn--primary head-btn">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M3 5.5C3 4.12 4.12 3 5.5 3h1.46a1 1 0 0 1 .97.76l1.04 4.16a1 1 0 0 1-.5 1.13l-1.6.8a14 14 0 0 0 6.28 6.28l.8-1.6a1 1 0 0 1 1.13-.5l4.16 1.04a1 1 0 0 1 .76.97V19.5C20 20.88 18.88 22 17.5 22h-1A14.5 14.5 0 0 1 2 7.5v-1Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        <span class="head-btn__label">Appeler</span>
      </a>
    </div>
  </div>
</header>

<div class="callbar">
  <a href={`tel:${NAP.phoneE164}`}>
    <span aria-hidden="true">✆</span> Appeler le dépannage — 24/7
  </a>
</div>

<style>
  /* --- Bandeau d'annonce nuit --- */
  .topbar {
    background: var(--c-ardoise-nuit);
    color: var(--c-ficelle);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: center;
    padding: 9px 16px;
  }
  .topbar b {
    color: var(--c-orange-clair);
    font-weight: 600;
  }

  /* --- Header sticky ardoise, liseré orange --- */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(43, 53, 64, 0.94);
    backdrop-filter: blur(9px);
    border-bottom: 2px solid var(--c-orange);
    color: var(--c-blanc);
  }
  .head-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 70px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.05;
    color: var(--c-blanc);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--c-blanc);
    text-decoration: none;
  }
  .brand__mark {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--c-orange);
    color: var(--c-ardoise-nuit);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    box-shadow: 0 0 0 3px rgba(47, 191, 113, 0.25);
  }
  .brand__text {
    display: flex;
    flex-direction: column;
  }
  .brand__title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 1.02rem;
    letter-spacing: 0.02em;
    color: var(--c-blanc);
  }
  .brand__sub {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-brume);
    font-weight: 500;
  }

  .head-nav {
    display: flex;
    gap: var(--space-5);
    margin-left: auto;
  }
  .head-nav a {
    color: var(--c-ficelle);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .head-nav a:hover {
    color: var(--c-orange-clair);
    text-decoration: none;
  }

  .head-cta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .head-phone {
    display: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    color: var(--c-blanc);
  }

  /* --- Barre d'appel mobile collée en bas --- */
  .callbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: none;
    background: var(--c-orange);
    box-shadow: 0 -8px 24px -10px rgba(25, 31, 38, 0.6);
  }
  .callbar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.16rem;
    padding: 15px;
    text-decoration: none;
  }
  .callbar a:hover {
    color: #fff;
    text-decoration: none;
  }

  @media (min-width: 760px) {
    .head-phone {
      display: block;
    }
  }
  @media (max-width: 880px) {
    .head-nav {
      display: none;
    }
    .head-cta {
      margin-left: auto;
    }
  }
  @media (max-width: 620px) {
    .brand__sub {
      display: none;
    }
    .head-btn {
      padding: 0.7em 0.9em;
    }
    .head-btn__label {
      display: none;
    }
    .callbar {
      display: block;
    }
    :global(body) {
      padding-bottom: 56px;
    }
  }
</style>
